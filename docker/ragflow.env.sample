# RAGFlow 本地部署配置（填入 .env 后执行 docker compose -f docker-compose.yml up -d）
#
# 本机前置检查结果（2026-11-21）：
#   CPU 16 核 / 内存 15.6 GB / D 盘剩余 204.7 GB
#   官方推荐 4 核 / 16 GB / 50 GB —— 内存为唯一瓶颈，需把 Docker Desktop
#   的 WSL 内存上限调到 10~12 GB（见 docker/.wslconfig.suggested）
#
# 端口说明：本机 3306/3307/13307/8000 已被占用，此处避开
#   80   -> 改为 9380（与 deepsearch 的 RAGFLOW_API_URL=http://localhost:9380 一致）
#   9380 -> 容器内部 API 端口，通过 SVR_HTTP_PORT 暴露到宿主机

# ---- Web / API 端口 ----
SVR_WEB_HTTP_PORT=9380
SVR_HTTP_PORT=9380

# ---- 镜像 ----
RAGFLOW_IMAGE=infiniflow/ragflow:v0.24.0
DOC_ENGINE=elasticsearch

# ---- 依赖服务凭据（本地开发用，公网部署前必须改）----
ELASTIC_PASSWORD=infini_rag_flow
MYSQL_PASSWORD=infini_rag_flow
MINIO_PASSWORD=infini_rag_flow

# ---- 时区 ----
TZ=Asia/Shanghai
